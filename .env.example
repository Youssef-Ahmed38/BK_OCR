# Copy to .env for local development. Never commit real credentials.
PORT=8000
DEBUG=false

# Object storage
MINIO_ENDPOINT=localhost:9000
ACCESS_KEY=replace-me
SECRET_KEY=replace-me
USE_SSL=false
BUCKET_NAME=bank-statements
MINIO_PREFIX_DATA=Data/
MINIO_PREFIX_CROPS=BK_Crops/

# Model paths
MODEL_PATH=FSA.pt
D_MODEL_PATH=d3.pt

# Optional OCR and geometry overrides
OCR_CONF_THRESHOLD=50
OCR_MAX_RETRIES=6
RANDOM_SEED=42
